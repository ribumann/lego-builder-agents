{
  "name": "bricklab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server.mjs --production",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:e2e": "playwright test",
    "package:azure": "python3 scripts/package_azure_release.py",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@azure/msal-browser": "^5.29.1",
    "@azure/storage-blob": "^12.34.0",
    "jose": "^6.2.12",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "3.8.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/three": "^0.180.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
