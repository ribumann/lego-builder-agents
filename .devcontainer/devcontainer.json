{
  "name": "BrickLab",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {
      "version": "latest"
    }
  },
  "containerEnv": {
    "BRICKLAB_GH_BIN": "/usr/bin/gh"
  },
  "postStartCommand": "node scripts/codespaces.mjs start",
  "waitFor": "updateContentCommand",
  "forwardPorts": [4173],
  "portsAttributes": {
    "4173": {
      "label": "BrickLab",
      "onAutoForward": "notify"
    }
  }
}
